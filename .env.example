# คัดลอกเป็น .env.local แล้วแก้ค่า — .env* ทั้งหมดถูก gitignore ยกเว้นไฟล์นี้

# base URL ของ backend (ไม่มี / ท้าย) · เว้นว่าง = เรียก mock route ใน app/api (same-origin)
# backend คนละ origin ต้องเปิด CORS พร้อม Access-Control-Allow-Credentials เพราะ apiFetch ส่ง cookie
NEXT_PUBLIC_API_BASE_URL=

# origin ของรูปจาก CDN / ค่ายเกม สำหรับ next/image (คั่นด้วย comma)
# ตัวอย่าง: https://cdn.cosmicbet.com,https://img.provider.io
NEXT_PUBLIC_IMAGE_HOSTS=

# secret เซ็น cookie ของ mock auth (app/api/auth) — ต้องตั้งเมื่อรัน production
# สร้างค่า: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SESSION_SECRET=

# URL หน้าเว็บจริง — ใช้สร้างลิงก์ชวนเพื่อนตอน render ฝั่ง server (ฝั่ง browser ใช้ origin ปัจจุบัน)
NEXT_PUBLIC_SITE_URL=
